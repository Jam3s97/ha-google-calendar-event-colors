#!/usr/bin/env bash

set -e

cd "$(dirname "$0")/.."

# Create config dir if not present
if [[ ! -d "${PWD}/config" ]]; then
    mkdir -p "${PWD}/config"
    hass --config "${PWD}/config" --script ensure_config
fi

# Link <root>/custom_components/google into the config dir, where Home
# Assistant looks for custom integrations. Without it, the built-in google
# integration loads instead. (Adding <root>/custom_components to PYTHONPATH
# doesn't work: Home Assistant imports the custom_components package from the
# config dir.)
mkdir -p "${PWD}/config/custom_components"
ln -sfn "${PWD}/custom_components/google" "${PWD}/config/custom_components/google"

# Start Home Assistant
hass --config "${PWD}/config" --debug
